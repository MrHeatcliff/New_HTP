# Source this file before direct DreamerV3/HTP launches:
#   source wandb.env.example
# Credentials are loaded by W&B from ~/.netrc; never put WANDB_API_KEY here.
export WANDB_ENTITY="${WANDB_ENTITY:-ttdat170703-ho-chi-minh-city-university-of-technology}"
export WANDB_MODE="${WANDB_MODE:-online}"

# run_arm.sh assigns dreamv3-<game> automatically. For a direct launch, set
# the matching project explicitly, for example:
# export WANDB_PROJECT="dreamv3-alien"

# Set these per experiment/run rather than globally:
# export WANDB_GROUP="paper-atari100k"
# export WANDB_JOB_TYPE="full"
# export WANDB_RUN_NAME="full_atari100k_alien_seed0"
# export WANDB_TAGS="paper,full,atari100k,alien,seed0"
